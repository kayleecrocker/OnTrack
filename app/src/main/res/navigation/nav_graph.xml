<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_tasks">

    <fragment
        android:id="@+id/nav_sleep"
        android:name="com.kayleecrocker.ontrack.fragments.SleepFragment"
        android:label="Sleep"
        tools:layout="@layout/fragment_sleep" />

    <fragment
        android:id="@+id/nav_tasks"
        android:name="com.kayleecrocker.ontrack.fragments.TasksFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_tasks" >

        <action
            android:id="@+id/action_tasks_to_details"
            app:destination="@id/taskDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_hobby"
        android:name="com.kayleecrocker.ontrack.fragments.HobbyFragment"
        android:label="Hobby"
        tools:layout="@layout/fragment_hobby" />

    <fragment
        android:id="@+id/taskDetailsFragment"
        android:name="com.kayleecrocker.ontrack.fragments.TaskDetailsFragment"
        android:label="Task Details"
        tools:layout="@layout/fragment_task_details">

        <argument
            android:name="taskId"
            app:argType="integer" />

    </fragment>
</navigation>